# 🥤 NovaLat - Variables de Entorno
# Archivo de ejemplo para configuración del sistema

# =============================================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =============================================================================

# Entorno de ejecución
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Configuración del servidor
HOST=0.0.0.0
PORT=8000
WORKERS=4

# =============================================================================
# BASE DE DATOS
# =============================================================================

# PostgreSQL
DATABASE_URL=postgresql://novalat_user:novalat_pass@localhost:5432/novalat_traceability
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=true

# =============================================================================
# CACHE Y SESIONES
# =============================================================================

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# =============================================================================
# AUTENTICACIÓN Y SEGURIDAD
# =============================================================================

# JWT
JWT_SECRET_KEY=novalat-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ALLOW_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# =============================================================================
# LOGGING
# =============================================================================

# Archivos de log
LOG_FILE=logs/novalat.log
JSON_LOG_FILE=logs/novalat.json
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# MONITOREO Y OBSERVABILIDAD
# =============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=admin

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=novalat-logs

# Jaeger
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# =============================================================================
# INTEGRACIONES EXTERNAS
# =============================================================================

# SAP S/4HANA
SAP_HOST=sap.example.com
SAP_CLIENT=100
SAP_USERNAME=novalat_user
SAP_PASSWORD=novalat_pass
SAP_LANGUAGE=ES

# Azure
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# =============================================================================
# CONFIGURACIÓN DE REGULACIONES
# =============================================================================

# DIGEMAPS (República Dominicana)
DIGEMAPS_ENABLED=true
DIGEMAPS_API_URL=https://api.digemaps.gob.do
DIGEMAPS_API_KEY=your-digemaps-api-key

# Codex Alimentarius
CODEX_ENABLED=true
CODEX_TEMPERATURE_MIN=-18
CODEX_TEMPERATURE_MAX=50

# ISO 22000
ISO22000_ENABLED=true
ISO22000_AUDIT_TRAIL_ENABLED=true

# =============================================================================
# CONFIGURACIÓN DE EMAIL
# =============================================================================

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@novalat.com
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true

# =============================================================================
# CONFIGURACIÓN DE NOTIFICACIONES
# =============================================================================

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_CHANNEL=#novalat-alerts

# Teams
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/your/webhook/url

# =============================================================================
# CONFIGURACIÓN DE BACKUP
# =============================================================================

# Backup automático
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Diario a las 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# =============================================================================
# CONFIGURACIÓN DE RENDIMIENTO
# =============================================================================

# Límites de rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST_SIZE=100

# Timeouts
REQUEST_TIMEOUT_SECONDS=30
DATABASE_TIMEOUT_SECONDS=10
REDIS_TIMEOUT_SECONDS=5

# =============================================================================
# CONFIGURACIÓN DE DESARROLLO
# =============================================================================

# Desarrollo local
LOCAL_DEVELOPMENT=true
AUTO_RELOAD=true
DEBUG_TOOLBAR_ENABLED=true

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/novalat_test
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =============================================================================

# Producción (sobrescribir en producción)
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=WARNING
# DATABASE_URL=postgresql://prod_user:prod_pass@prod-db:5432/novalat_prod
# REDIS_URL=redis://prod-redis:6379/0
# JWT_SECRET_KEY=your-super-secure-production-secret-key 